APP_NAME=Mojawad
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Media binaries (Studio importer, clip renderer, publishing pipeline) ──
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# ── Branding & Publishing pipeline ──────────────────────────────────────
# AI ayah detection (leave ASR_API_KEY empty to keep ayah range fully manual)
ASR_DRIVER=openai
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1

# Subtitle alignment (needs aeneas on the worker host: python -m aeneas.tools.execute_task)
SUBTITLES_ENABLED=false
AENEAS_BINARY=python
SUBTITLE_GRANULARITY=ayah

# Cover rendering: browsershot (needs Node + Chrome) or ffmpeg fallback
COVER_DRIVER=browsershot

# Optional brand stingers / bumpers (absolute paths)
BRAND_INTRO_AUDIO=
BRAND_OUTRO_AUDIO=
BRAND_INTRO_VIDEO=
BRAND_OUTRO_VIDEO=
PUBLISH_RENDER_TIMEOUT=1800

# Podcast feed (submit /podcast/feed.xml to Spotify & Anghami once)
PODCAST_EMAIL=

# YouTube Data API v3 (uploads stay private until Google's audit passes)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=private

# Facebook Page (long-lived page token, pages_manage_posts)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
